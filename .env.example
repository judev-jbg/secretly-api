## Local database: use these variables OR DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secretly
DB_USER=postgres
DB_PASSWORD=change-me

## Production: copy Supabase's connection string and include sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

## Security: use a long, random value in production.
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

## CORS: comma-separated origins without a trailing slash.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

## Optional email settings, required for password reset emails.
SMTP_SERVER=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
